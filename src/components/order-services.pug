include mixins.pug
section.order-services
    .order-services__layout

        // Ліва частина — категорії
        aside.order-services__sidebar
            h2.order-services__sidebar-title Категорії послуг

            .order-services__categories
                .order-services__category.order-services__category--active
                    img(src="/images/service-microphone.png" alt="")
                    span Ведучі

                .order-services__category
                    img(src="/images/service-camera.png" alt="")
                    span Фотографи

                .order-services__category
                    img(src="/images/service-catering-icon.png" alt="")
                    span Кейтеринг

        // Права частина
        .order-services__main

            // Картки ведучих
            .order-services__catalog
                -
                    const services = [
                        {
                            name: "Олександр Коваль",
                            image: "/images/host-oleksandr.png",
                            rating: "4.9 (124)",
                            description: "Професійний ведучий із досвідом понад 8 років. Створює невимушену атмосферу на весіллях, днях народження та корпоративних заходах.",
                            price: "8 000",
                            selected: true
                        },
                        {
                            name: "Марія Іваненко",
                            image: "/images/host-mariia.png",
                            rating: "4.8 (101)",
                            description: "Харизматична ведуча, яка поєднує сучасні розважальні програми з індивідуальним підходом до кожного свята.",
                            price: "7 500",
                            selected: false
                        },
                        {
                            name: "Дмитро Соловей",
                            image: "/images/host-dmytro.png",
                            rating: "4.7 (67)",
                            description: "Енергійний ведучий із креативним підходом до організації свят. Проводить інтерактивні конкурси та легко знаходить спільну мову з гостями.",
                            price: "6 800",
                            selected: false
                        }
                    ]

                each service in services
                    +serviceCard(service)

            // Нижня частина
            .order-services__summary

                // Обрані послуги
                .order-services__selected
                    h2.order-services__selected-title Обрані послуги (2)

                    +selectedService("Олександр Коваль", "Ведучий", "/images/host-oleksandr.png", "8 000")
                    +selectedService("Вероніка Бойко", "Фотограф", "/images/photographer-veronika.png", "7 000")

                // Вартість і перехід
                .order-services__checkout
                    .order-services__total
                        h2 Загальна вартість послуг:
                        strong 15 000 грн

                    a.order-services__next(href="/order-confirmation.html") Далі →